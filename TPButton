local function FKDRPI_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	local button = script.Parent
	local player = game.Players.LocalPlayer
	local mouse = player:GetMouse()
	local teleportMode = false
	
	button.Text = "TP"
	
	button.MouseButton1Click:Connect(function()
		teleportMode = not teleportMode
		button.Text = teleportMode and "TP ON" or "ТP OFF"
	end)
	
	mouse.Button1Down:Connect(function()
		if teleportMode then
			local character = player.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local hrp = character.HumanoidRootPart
				local pos = mouse.Hit.p
				hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) -- приподнимает над точкой, чтобы не застрял
			end
		end
	end)
end
coroutine.wrap(FKDRPI_fake_script)()
local function TDZT_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	local UIS = game:GetService('UserInputService')
	
	local frame = script.Parent
	
	
	local dragToggle = nil
	
	local dragSpeed = 0.25
	
	local dragStart = nil
	
	local startPos = nil
	
	
	
	local function updateInput(input)
	
		local delta = input.Position - dragStart
	
		local position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
	
			startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	
		game:GetService('TweenService'):Create(frame, TweenInfo.new(dragSpeed), {Position = position}):Play()
	
	end
	
	
	
	frame.InputBegan:Connect(function(input)
	
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then 
	
			dragToggle = true
	
			dragStart = input.Position
	
			startPos = frame.Position
	
			input.Changed:Connect(function()
	
				if input.UserInputState == Enum.UserInputState.End then
	
					dragToggle = false
	
				end
	
			end)
	
		end
	
	end)
	
	
	
	UIS.InputChanged:Connect(function(input)
	
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
	
			if dragToggle then
	
				updateInput(input)
	
			end
	
		end
	
	end)
	
	
end
coroutine.wrap(TDZT_fake_script)()
local function XRYBJF_fake_script() -- TextButton_2.LocalScript 
	local script = Instance.new('LocalScript', TextButton_2)

	local button = script.Parent
	local isOpen = true -- состояние, открыто или закрыто
	
	local function toggleGUI()
		local parentGui = button.Parent
		if isOpen then
			-- скрываем все, кроме самой кнопки
			for _, child in pairs(parentGui:GetChildren()) do
				if child ~= button and child:IsA("GuiObject") then
					child.Visible = false
				end
			end
			isOpen = false
		else
			-- показываем всё обратно
			for _, child in pairs(parentGui:GetChildren()) do
				if child ~= button and child:IsA("GuiObject") then
					child.Visible = true
				end
			end
			isOpen = true
		end
	end
	
	-- Используем событие Activated для ImageButton (поддерживает клик)
	button.Activated:Connect(toggleGUI)
end
coroutine.wrap(XRYBJF_fake_script)()
